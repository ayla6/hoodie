# GNOME-only apps without a Fedora RPM, preinstalled on first boot by
# flatpak-preinstall.service (the rest ship as system packages)
[Flatpak Preinstall com.mattjakeman.ExtensionManager]
Branch=stable
Install=true

[Flatpak Preinstall io.github.realmazharhussain.GdmSettings]
Branch=stable
Install=true
