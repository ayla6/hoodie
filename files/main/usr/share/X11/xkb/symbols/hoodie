// hoodie custom keyboard layout
//
// Base: Colemak-DH Wide ISO (levels 1-2)
//   Level 3 (AltGr): symbols layer (shifted punctuation without Shift)
//   Level 5 (Menu):  accent layer (Menu key acts as ISO_Level5_Shift)
//   Level 6 (Shift+Menu): uppercase accents

default partial alphanumeric_keys modifier_keys
xkb_symbols "basic" {

    name[Group1] = "English (Colemak-DH Wide ISO Symbols)";

    include "us(colemak_dh_wide_iso)"
    include "level3(ralt_switch)"
    include "level5(menu_switch)"

    key.type[Group1] = "EIGHT_LEVEL";

    // ---- number row ---------------------------------------------------
    key <TLDE> { [ grave, asciitilde,grave, asciitilde,          dead_grave, dead_grave ] };
    key <AE01> { [     1,     exclam,    1,     exclam,          exclamdown, exclamdown ] };
    key <AE02> { [     2,         at,    2,         at,                cent,       cent ] };
    key <AE03> { [     3, numbersign,    3, numbersign,            EuroSign,   EuroSign ] };
    key <AE04> { [     4,     dollar,    4,     dollar,         ordfeminine, ordfeminine ] };
    key <AE05> { [     5,    percent,    5,    percent,           masculine,  masculine ] };
    key <AE06> { [     6,asciicircum,    6,asciicircum,        questiondown, questiondown ] };
    key <AE07> { [ equal,       plus,equal,       plus,       guillemotleft, guillemotright ] };
    key <AE08> { [     7,  ampersand,    7,  ampersand,      guillemotright, guillemotleft ] };
    key <AE09> { [     8,   asterisk,    8,   asterisk, leftsinglequotemark, leftdoublequotemark] };
    key <AE10> { [     9,  parenleft,    9,  parenleft,rightsinglequotemark,rightdoublequotemark] };
    key <AE11> { [     0, parenright,    0, parenright,          dead_tilde,   dead_tilde ] };
    key <AE12> { [ minus, underscore,emdash,    endash,          dead_acute,   dead_acute ] };

    // ---- top row -------------------------------------------------------
    key <AD01> { [         q,        Q,     percent,     percent,     agrave,     Agrave ] };
    key <AD02> { [         w,        W,      exclam,      exclam,acircumflex, Acircumflex ] };
    key <AD03> { [         f,        F,        plus,        plus,     atilde,     Atilde ] };
    key <AD04> { [         p,        P, bracketleft,   braceleft, odiaeresis, Odiaeresis ] };
    key <AD05> { [         b,        B,          at,          at,   NoSymbol,   NoSymbol ] };
    // key <AD06> { [ ] };
    key <AD07> { [         j,        J,  numbersign,  numbersign,   NoSymbol,   NoSymbol ] };
    key <AD08> { [         l,        L,bracketright,  braceright,   NoSymbol,   NoSymbol ] };
    key <AD09> { [         u,        U,  underscore,  underscore,     uacute,     Uacute ] };
    key <AD10> { [         y,        Y,    question,    question, dead_diaeresis,dead_diaeresis ] };
    key <AD11> { [ semicolon,    colon, asciicircum, asciicircum,dead_circumflex,dead_circumflex] };
    key <AD12> { [     slash, question,questiondown,  asciitilde, dead_grave, dead_grave ] };
    key <BKSL> { [apostrophe,  quotedbl, asciitilde,  asciitilde,     otilde,     Otilde ] };

    // ---- home row ------------------------------------------------------
    key <AC01> { [         a,         A,      slash,      slash,     aacute,     Aacute ] };
    key <AC02> { [         r,         R,      colon,      colon, adiaeresis, Adiaeresis ] };
    key <AC03> { [         s,         S,      equal,      equal,     ssharp,   0x1001e9e] };
    key <AC04> { [         t,         T,  braceleft,  braceleft,ecircumflex, Ecircumflex] };
    key <AC05> { [         g,         G,     dollar,     dollar,     otilde,     Otilde ] };
    // key <AC06> { [ ] };
    key <AC07> { [         m,         M,  backslash,  backslash,   NoSymbol,   NoSymbol ] };
    key <AC08> { [         n,         N, braceright, braceright,     ntilde,     Ntilde ] };
    key <AC09> { [         e,         E,   quotedbl,   quotedbl,     eacute,     Eacute ] };
    key <AC10> { [         i,         I,  semicolon,   semicolon,     iacute,     Iacute ] };
    key <AC11> { [         o,         O,      minus,       minus,     oacute,     Oacute ] };
    key <AC12> { [apostrophe,  quotedbl, asciitilde,  asciitilde,     otilde,     Otilde ] };

    // ---- bottom row ----------------------------------------------------
    key <LSGT> { [         z,         Z, numbersign, numbersign,   NoSymbol,   NoSymbol ] };
    key <AB01> { [         x,         X,      grave, asciitilde,   NoSymbol,   NoSymbol ] };
    key <AB02> { [         c,         C,   asterisk,   asterisk,   ccedilla,   Ccedilla ] };
    key <AB03> { [         d,         D,  parenleft,  parenleft,ocircumflex, Ocircumflex ] };
    key <AB04> { [         v,         V,  ampersand,  ampersand,   NoSymbol,   NoSymbol ] };
    key <AB05> { [  NoSymbol,  NoSymbol,     Escape,     Escape,   NoSymbol,   NoSymbol ] };
    // key <AB06> { [ ] };
    key <AB07> { [         k,         K,        bar,        bar,   NoSymbol,   NoSymbol ] };
    key <AB08> { [         h,         H, parenright, parenright, udiaeresis, Udiaeresis ] };
    key <AB09> { [     comma,      less,       less,      less,  dead_tilde,  dead_tilde ] };
    key <AB10> { [    period,   greater,    greater,  ellipsis,dead_cedilla, dead_cedilla ] };
    // because chromium still opens menu
    key <AB11> {[ ISO_Level5_Shift ], type[group1]="ONE_LEVEL" };
};
