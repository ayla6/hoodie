// hoodie custom keyboard layout
//
// Base: Colemak-DH Wide ISO (levels 1-2)
//   Level 3 (AltGr): symbols layer (shifted punctuation without Shift)
//   Level 5 (Menu):  accent layer (Menu key acts as ISO_Level5_Shift)
//   Level 6 (Shift+Menu): uppercase accents
//   Level 7 (AltGr+Menu): õ
//
// Symbols layer (physical key -> output):
//   top:   q:% w:! f:+ p:[ b:@  j:# l:] u:_ y:? ;:^
//   home:  a:/ s:= t:{ g:$  m:\ n:} e:" i:; o:-
//   bottom:z:# x:` c:* v:( \:& ,:| .:) /:<
//   disabled (AltGr+key does nothing): physical n, m, [, ]
//
// Accent layer (colemak letter -> output):
//   a:á e:é i:í o:ó u:ú c:ç n:ñ s:ß f:ã
//   dead keys (physical): ` grave, [ circumflex, ] grave, 0 tilde,
//     = acute, p diaeresis, / cedilla
//   numbers: 1:¡ 2:¢ 3:€ 4:ª 5:º 6:¿ 7:« 8:» 9:' 0:'
//   Shift+accent = uppercase (á->Á, ß->ẞ), AltGr+o = õ

default partial alphanumeric_keys modifier_keys
xkb_symbols "basic" {

    name[Group1] = "English (Colemak-DH Wide ISO Symbols)";

    include "us(colemak_dh_wide_iso)"
    include "level3(ralt_switch)"
    include "level5(menu_switch)"

    key.type[Group1] = "EIGHT_LEVEL";

    // ---- number row ---------------------------------------------------
    key <TLDE> { [     grave, asciitilde,       grave, asciitilde, dead_grave, dead_grave, NoSymbol, NoSymbol ] };
    key <AE01> { [         1,     exclam,           1,     exclam, exclamdown, exclamdown, NoSymbol, NoSymbol ] };
    key <AE02> { [         2,         at,           2,         at,       cent,       cent, NoSymbol, NoSymbol ] };
    key <AE03> { [         3, numbersign,           3, numbersign,   EuroSign,   EuroSign, NoSymbol, NoSymbol ] };
    key <AE04> { [         4,     dollar,           4,     dollar, ordfeminine, ordfeminine, NoSymbol, NoSymbol ] };
    key <AE05> { [         5,    percent,           5,    percent,  masculine,  masculine, NoSymbol, NoSymbol ] };
    key <AE06> { [         6, asciicircum,          6, asciicircum, questiondown, questiondown, NoSymbol, NoSymbol ] };
    key <AE07> { [      equal,      plus,       equal,      plus, guillemotleft, guillemotright, NoSymbol, NoSymbol ] };
    key <AE08> { [         7,  ampersand,           7,  ampersand, guillemotright, guillemotleft, NoSymbol, NoSymbol ] };
    key <AE09> { [         8,   asterisk,           8,   asterisk, leftsinglequotemark, leftdoublequotemark, NoSymbol, NoSymbol ] };
    key <AE10> { [         9,  parenleft,           9,  parenleft, rightsinglequotemark, rightdoublequotemark, NoSymbol, NoSymbol ] };
    key <AE11> { [         0, parenright,           0, parenright,   dead_tilde,   dead_tilde, NoSymbol, NoSymbol ] };
    key <AE12> { [     minus, underscore,      minus, underscore,  dead_acute,   dead_acute, NoSymbol, NoSymbol ] };

    // ---- top row -------------------------------------------------------
    key <AD01> { [         q,         Q,     percent,     percent,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AD02> { [         w,         W,      exclam,      exclam,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AD03> { [         f,         F,        plus,        plus,     atilde,     Atilde, NoSymbol, NoSymbol ] };
    key <AD04> { [         p,         P, bracketleft, braceleft,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AD05> { [         b,         B,          at,          at,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AD06> { [ bracketleft, braceleft,   NoSymbol,   NoSymbol,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AD07> { [         j,         J, numbersign, numbersign,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AD08> { [         l,         L, bracketright, braceright,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AD09> { [         u,         U, underscore, underscore,     uacute,     Uacute, NoSymbol, NoSymbol ] };
    key <AD10> { [         y,         Y,   question,   question, dead_diaeresis, dead_diaeresis, NoSymbol, NoSymbol ] };
    key <AD11> { [ semicolon,     colon, asciicircum, asciicircum, dead_circumflex, dead_circumflex, NoSymbol, NoSymbol ] };
    key <AD12> { [     slash,  question,      slash,  question, dead_grave, dead_grave, NoSymbol, NoSymbol ] };
    key <BKSL> { [apostrophe, quotedbl, asciitilde, asciitilde,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };

    // ---- home row ------------------------------------------------------
    key <AC01> { [         a,         A,      slash,  question,     aacute,     Aacute, NoSymbol, NoSymbol ] };
    key <AC02> { [         r,         R,      colon,     colon,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AC03> { [         s,         S,      equal,     equal,     ssharp,   0x1001e9e, NoSymbol, NoSymbol ] };
    key <AC04> { [         t,         T, braceleft, braceright,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AC05> { [         g,         G,     dollar,     dollar,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AC06> { [bracketright, braceright,   NoSymbol,   NoSymbol,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AC07> { [         m,         M,  backslash,       bar,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AC08> { [         n,         N, braceright, braceright,     ntilde,     Ntilde, NoSymbol, NoSymbol ] };
    key <AC09> { [         e,         E,  quotedbl,  quotedbl,     eacute,     Eacute, NoSymbol, NoSymbol ] };
    key <AC10> { [         i,         I, semicolon,     colon,     iacute,     Iacute, NoSymbol, NoSymbol ] };
    key <AC11> { [         o,         O,     minus, underscore,     oacute,     Oacute,   otilde,   Otilde ] };

    // ---- bottom row ----------------------------------------------------
    key <LSGT> { [         z,         Z,          z,          Z,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AB01> { [         x,         X, numbersign, numbersign,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AB02> { [         c,         C,      grave, asciitilde,   ccedilla,   Ccedilla, NoSymbol, NoSymbol ] };
    key <AB03> { [         d,         D,   asterisk,   asterisk,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AB04> { [         v,         V,  parenleft,  parenleft,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AB05> { [ backslash,       bar,  ampersand,  ampersand,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AB06> { [numbersign, asciitilde,   NoSymbol,   NoSymbol,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AB07> { [         k,         K,   NoSymbol,   NoSymbol,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AB08> { [         h,         H,        bar,        bar,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AB09> { [     comma,      less, parenright, parenright,   NoSymbol,   NoSymbol, NoSymbol, NoSymbol ] };
    key <AB10> { [    period,   greater,      less,      less, dead_cedilla, dead_cedilla, NoSymbol, NoSymbol ] };
};
