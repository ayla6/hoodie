{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "rebaseWhen": "never",
  "enabledManagers": ["dockerfile", "github-actions", "custom.regex"],
  "dockerfile": {
    "enabled": true,
    "managerFilePatterns": ["/(^|/)Containerfile$/"],
    "pinDigests": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Containerfile BASE_IMAGE_GNOME (inline tag + digest)",
      "managerFilePatterns": ["/(^|/)Containerfile$/"],
      "matchStrings": [
        "ARG BASE_IMAGE_GNOME=\"(?<packageName>[^:\"]+):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Containerfile BASE_IMAGE_KDE (inline tag + digest)",
      "managerFilePatterns": ["/(^|/)Containerfile$/"],
      "matchStrings": [
        "ARG BASE_IMAGE_KDE=\"(?<packageName>[^:\"]+):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Containerfile BREW_IMAGE pair (tag + digest in separate ARGs)",
      "managerFilePatterns": ["/(^|/)Containerfile$/"],
      "matchStrings": [
        "ARG BREW_IMAGE=\"(?<depName>[^:\"]+):(?<currentValue>[^\"@]+)\"[\\s\\S]+?ARG BREW_IMAGE_SHA=\"(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Container images in Justfile with tag and digest",
      "managerFilePatterns": ["/^Justfile$/"],
      "matchStrings": [
        "(?<justName>.+?)\\s:=\\s(?:env\\(.+?,\\s)?['\"](?<packageName>\\S+?):(?<currentValue>\\S+?)@(?<currentDigest>sha256:[a-f0-9]+?)['\"]\\)?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Container images in Justfile podman run args without digest",
      "managerFilePatterns": ["/^Justfile$/"],
      "matchStrings": [
        "(?<packageName>[a-zA-Z0-9._:/-]+):latest[ \\\\]"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "currentValueTemplate": "latest"
    }
  ],
  "packageRules": [
    {
      "description": "Auto-merge all digest pins",
      "matchUpdateTypes": ["pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Pin all Docker images with digests and auto-merge digest updates",
      "matchDatasources": ["docker"],
      "pinDigests": true,
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "labels": ["renovate", "automerge"]
    },
    {
      "description": "Enable and auto-merge GitHub Actions digest updates",
      "matchDepTypes": ["action"],
      "matchFileNames": [".github/workflows/**"],
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "pinDigests": true,
      "automerge": true,
      "enabled": true
    },
    {
      "description": "Manual review for major/minor version updates",
      "matchUpdateTypes": ["major", "minor"],
      "automerge": false
    },
    {
      "description": "Pin digests for container images detected by custom regex managers",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Stay on cosign v2 (v3 breaks rpm-ostree signature verification)",
      "matchPackageNames": ["sigstore/cosign"],
      "allowedVersions": "/^v2/"
    }
  ]
}
