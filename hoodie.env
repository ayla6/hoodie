# hoodie build configuration
# Local defaults; override via environment variables when building.

# Output image name, same as repo name
IMAGE_NAME=hoodie

# GitHub username/organisation
REPO_ORGANIZATION=aylac

# Image flavor: gnome or kde
IMAGE_FLAVOR=gnome

# Image metadata
IMAGE_DESC="hoodie - a personal Fedora Atomic bootc image with GNOME and KDE variants"
IMAGE_KEYWORDS="bootc,ublue,universal-blue,gaming,nvidia"
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"

# Tags
DEFAULT_TAG=stable

# Bootc Image Builder
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"

# QEMU for local VM testing
QEMU_IMAGE="docker.io/qemux/qemu:latest"
